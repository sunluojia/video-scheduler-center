# 运行配置（除服务凭据外均有默认值，按需覆盖）。本地开发时复制到 backend/.env，compose 部署时复制到项目根目录的 .env
SC_DATABASE_URL=postgresql+asyncpg://scheduler:scheduler@localhost:5432/scheduler_center
# 与爬取程序、分析服务共用的 Redis 和 Dramatiq 命名空间
SC_REDIS_URL=redis://localhost:6379/0
SC_QUEUE_NAMESPACE=dramatiq
# 爬取程序上传的原视频，API 与 Worker 共享
SC_MATERIAL_ROOT=data/materials

# 三个程序互相调用的服务凭据，不少于 16 位，与爬取程序、分析服务配置一致（API 启动时需要）
SC_SERVICE_TOKEN=
# 默认只监听本机；执行程序在其他机器上时改为 0.0.0.0
SC_API_HOST=127.0.0.1
SC_API_PORT=8080
# 执行程序超过这个秒数没有心跳视为离线
SC_HEARTBEAT_TIMEOUT_SECONDS=60
# 已发布的任务超过这个分钟数仍未受理，重新投递
SC_RECONCILE_AFTER_MINUTES=30

# 测试使用的独立测试库，测试会重建其中的表
# SC_TEST_DATABASE_URL=postgresql+asyncpg://video:video@localhost:55432/scheduler_center_test
